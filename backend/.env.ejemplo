# Copia este archivo a backend/.env y ajusta los valores.
PUERTO=3001
ENTORNO=development

# Conexión a PostgreSQL (contenedor mlsiesa_db en la red interna)
DATABASE_URL=postgres://mlsiesa:cambia_esta_contrasena@mlsiesa_db:5432/mlsiesa

# JWT
JWT_SECRETO=cambia_esto_por_un_secreto_largo_min_32_caracteres
JWT_EXPIRACION=7d

# URL del frontend (para CORS en produccion)
URL_FRONTEND=http://localhost:8080

# Conector SIESA (web service WSUNOEE). La clave NUNCA va en el repositorio.
#
# Ambiente: deje activo UNO de los dos bloques y comente el otro con "#".
#   Pruebas     conexión "Pruebas",        usuario "ia". Se sobrescribe a diario (19:00) con producción.
#   Producción  conexión "Propartes Real", usuario "ml". Crea pedidos y clientes reales.
# La clave de cada usuario la entrega TI. Después de cambiar de bloque, recree el contenedor:
#   docker compose up -d --force-recreate mlsiesa_backend
SIESA_ENDPOINT=http://200.119.85.58:8080/WSUNOEE/WSUNOEE.asmx
SIESA_CIA=1

# --- Pruebas ---
SIESA_CONEXION=Pruebas
SIESA_USUARIO=ia
SIESA_CLAVE=

# --- Producción ---
# SIESA_CONEXION=Propartes Real
# SIESA_USUARIO=ml
# SIESA_CLAVE=

SIESA_PROVEEDOR=PROPARTES
SIESA_CONSULTA_TERCEROS=CONSULTA_TERCERO_ECOMMERCE
# Centro de costo de venta de cada ítem (sql/CONSULTA_ITEM_ML.sql, la registra TI)
SIESA_CONSULTA_ITEMS=CONSULTA_ITEM_ML
# Número y líneas del pedido creado en SIESA (sql/CONSULTA_PEDIDO_ML.sql)
SIESA_CONSULTA_PEDIDOS=CONSULTA_PEDIDO_ML
SIESA_TIMEOUT_MS=180000
